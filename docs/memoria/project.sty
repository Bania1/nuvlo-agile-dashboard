% CHAPTER TITLES, based on: https://www.sharelatex.com/learn/Environments#!#Reference_guide
\makeatletter
\def\thickhrulefill{\leavevmode \leaders \hrule height 1.2ex \hfill \kern \z@}
\def\@makechapterhead#1{
  \vfill
  \vspace*{5cm plus 10cm minus 4cm}%
  {\parskip=0cm \parindent=0pt \centering \reset@font
        \Huge{\color{line} \thickhrulefill\quad
        \bfseries\textit{\scshape\sffamily\@chapapp{} \thechapter}
%        \scshape\bfseries {\fontsize{2cm}{2.2cm}\selectfont \thechapter} % \@chapapp{} \textit{
%        \scshape\bfseries\textit{\fontsize{2cm}{2.2cm}\selectfont\@chapapp{} \thechapter}}
        \quad \thickhrulefill}
        \par\nobreak
        \vspace*{10pt}%
        \interlinepenalty\@M
        \hrule
        \vspace*{10pt}%
        \Huge \bfseries #1 \par\nobreak
        \par
        \vspace*{10pt}%
        \hrule
        \bigskip
  }}

